# ==============================================================================
# ClinicOS / VetOS — Production Environment Configuration Template
# Copy this file to .env.production on your production server and update values.
# DO NOT commit .env.production to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DOMAIN & INGRESS
# ------------------------------------------------------------------------------
# Set to your fully qualified public domain name (e.g. clinic.yourcompany.com).
# Caddy will automatically issue and renew a free Let's Encrypt / ZeroSSL certificate.
DOMAIN_NAME=clinic.example.com

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
POSTGRES_DB=vetos
POSTGRES_USER=postgres
# Generate a strong 32+ character random password: openssl rand -hex 16
POSTGRES_PASSWORD=replace_with_strong_postgres_admin_password_32_chars

# Application unprivileged DB role credentials (used by Spring Boot at runtime)
APP_DB_USER=vetos_app
APP_DB_PASSWORD=replace_with_strong_app_user_password_32_chars

# JDBC URLs used by Spring Boot inside the Docker network
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/vetos
SPRING_DATASOURCE_USERNAME=vetos_app
SPRING_DATASOURCE_PASSWORD=replace_with_strong_app_user_password_32_chars

SPRING_FLYWAY_URL=jdbc:postgresql://postgres:5432/vetos
SPRING_FLYWAY_USER=postgres
SPRING_FLYWAY_PASSWORD=replace_with_strong_postgres_admin_password_32_chars

# ------------------------------------------------------------------------------
# 3. REDIS CACHE
# ------------------------------------------------------------------------------
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. BACKEND SECURITY (JWT)
# ------------------------------------------------------------------------------
# Must be at least 32-64 bytes (random hex or base64): openssl rand -hex 32
VETOS_JWT_SECRET=replace_with_secure_random_64_character_hex_jwt_secret

# Platform Super-Admin Secret (used by server scripts to onboard clinics & reset passwords)
VETOS_PLATFORM_ADMIN_SECRET=replace_with_secure_random_64_character_admin_secret

# Active Spring Profile (enforces production security defaults)
SPRING_PROFILES_ACTIVE=prod,dev

# ------------------------------------------------------------------------------
# 5. FRONTEND WEB CONFIGURATION
# ------------------------------------------------------------------------------
# Internal server-to-server origin for Next.js SSR requests
API_ORIGIN=http://api:8080

# Public browser-facing API URL
NEXT_PUBLIC_API_URL=https://clinic.example.com/api/v1

# ------------------------------------------------------------------------------
# 6. EXTERNAL INTEGRATIONS (OPTIONAL / PRODUCTION COMMUNICATIONS)
# ------------------------------------------------------------------------------
# Meta Cloud API credentials for automated WhatsApp appointment reminders & invoices
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=

# Email SMTP / Resend Credentials
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
